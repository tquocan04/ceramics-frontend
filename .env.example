# Where the frontend sends every API call.
#
# Leave empty (the default) and it talks to the mock backend in app/api,
# which implements the §16 endpoints against an in-memory store.
#
# Point it at the real backend when that exists, and delete app/api — no UI
# code changes, because every request goes through lib/api/client.ts.
#
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=

# ── Ceramics AI Service ───────────────────────────────────────────────────
#
# Where the Next proxy at /api/ai forwards to. Server-side only, so the
# internal API key never reaches the browser.
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=

# Upstream timeout for the proxy. An extraction is a real LLM call — the
# reference response reports latency_ms 17001 — so keep this generous.
AI_TIMEOUT_MS=90000

# Set this to bypass the proxy and have the browser call the AI service
# directly (needs CORS enabled on the FastAPI side). Leave empty in normal
# use; it is a debugging escape hatch. Note the internal API key is NOT sent
# on this route — it never leaves the server.
# NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=

# Client-side timeout in lib/ai/client.ts. Keep it in step with AI_TIMEOUT_MS
# above, or the browser gives up before the proxy does.
NEXT_PUBLIC_AI_TIMEOUT_MS=90000

# ── Telegram notifications ────────────────────────────────────────────────
#
# The simulation posts its notifications to the Express backend, which owns the
# bot token and does the actual Telegram call:
#
#   POST {BACKEND_API_BASE_URL}/api/notifications/trigger
#
# That endpoint sends no CORS headers, so it is only ever called from a Next
# server context (lib/mock/telegram.ts) — never from the browser.
#
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID do NOT belong here. They live in the
# Express backend's own .env; this frontend never sees them. Setup walkthrough
# is in README.md → "Telegram notifications".
#
# OFF by default on purpose. Turning it on points a running simulation at a
# real group chat, so it has to be a deliberate act. There is also a toggle in
# the demo panel (flask icon) for flipping it without a restart.
TELEGRAM_NOTIFY_ENABLED=false

# Where the Express backend listens. Its dev default is 5000.
BACKEND_API_BASE_URL=http://localhost:5000

# Pacing. Telegram throttles a group at roughly 20 messages/minute; 3500ms
# leaves headroom at about 17/min. Alerts jump the queue ahead of routine
# "stage completed" traffic.
TELEGRAM_MIN_INTERVAL_MS=3500

# Backpressure ceiling. Past this, the oldest routine message is dropped and
# marked FAILED in the outbox. Warnings and critical alerts are never dropped.
TELEGRAM_QUEUE_MAX=40

# The backend applies no timeout of its own to the Telegram call.
TELEGRAM_TIMEOUT_MS=8000
