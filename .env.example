# Where the frontend sends every API call.
#
# Leave empty (the default) and it talks to the mock backend in app/api,
# which implements the §16 endpoints against an in-memory store.
#
# Point it at the real backend when that exists, and delete app/api — no UI
# code changes, because every request goes through lib/api/client.ts.
#
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# ── Ceramics AI Service ───────────────────────────────────────────────────
#
# Where the Next proxy at /api/ai forwards to. Server-side only, so the
# internal API key never reaches the browser.
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=

# Upstream timeout for the proxy. An extraction is a real LLM call — the
# reference response reports latency_ms 17001 — so keep this generous.
AI_TIMEOUT_MS=90000

# Set this to bypass the proxy and have the browser call the AI service
# directly (needs CORS enabled on the FastAPI side). Leave empty in normal
# use; it is a debugging escape hatch.
# NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=
